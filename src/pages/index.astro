---
import Layout from "../layouts/Layout.astro"
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";

const posts = await getCollection("blog");

// Sort posts from newest to oldest
const recentPosts = posts
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 5);

const [featuredPost, ...otherPosts] = recentPosts;
---

<Layout>
  <!--Landing Page -->
  <main>

    <!-- Blog Posts -->
    {featuredPost && (
      <section class="post-grid">

        <!-- Featured Post -->
        <a
          href={`/blog/${featuredPost.id}`}
          class="featured-post"
        >
          {featuredPost.data.heroImage && (
            <img
              src={featuredPost.data.heroImage}
              alt={featuredPost.data.title}
            />
          )}

          <div class="post-overlay">

            <span class="date">
              {featuredPost.data.pubDate.toLocaleDateString()}
            </span>

            <!-- Tags -->
            <div class="tags">
              {featuredPost.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <h2>{featuredPost.data.title}</h2>

            <p>{featuredPost.data.description}</p>

          </div>
        </a>

        <!-- Other Four Posts -->
        <div class="small-posts">
          {otherPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="small-post"
            >
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                />
              )}

              <div class="small-post-info">

                <span class="date">
                  {post.data.pubDate.toLocaleDateString()}
                </span>

                <!-- Tags -->
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>

                <h3>{post.data.title}</h3>

                <p>{post.data.description}</p>

              </div>
            </a>
          ))}
        </div>

      </section>
    )}
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  /* Main Post Layout */

  .post-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  /* Featured Post */

  .featured-post {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 12px;
    text-decoration: none;
    color: white;
    background: #ddd;
  }

  .featured-post img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    background: linear-gradient(
      transparent,
      rgba(0, 0, 0, 0.85)
    );
  }

  .post-overlay h2 {
    font-size: 32px;
    margin: 8px 0;
  }

  .post-overlay p {
    margin: 0;
    line-height: 1.5;
  }

  /* Small Posts */

  .small-posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .small-post {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .small-post:hover,
  .featured-post:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .small-post img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .small-post-info {
    padding: 16px;
  }

  /* Date */

  .date {
    font-size: 13px;
    color: #888;
  }

  .post-overlay .date {
    color: #ddd;
  }

  /* Tags */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0;
  }

  .tag {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 20px;
    background: #eeeeee;
    color: #555;
    font-size: 12px;
    font-weight: 600;
  }

  .post-overlay .tag {
    background: rgba(255, 255, 255, 0.9);
    color: #333;
  }

  /* Small Post Text */

  .small-post-info h3 {
    margin: 6px 0;
    font-size: 20px;
  }

  .small-post-info p {
    margin: 0;
    color: #666;
    font-size: 14px;
    line-height: 1.4;
  }

  /* Tablet */

  @media (max-width: 700px) {
    .post-grid {
      grid-template-columns: 1fr;
    }

    .small-posts {
      grid-template-columns: 1fr 1fr;
    }

    .hero h1 {
      font-size: 36px;
    }
  }

  /* Mobile */

  @media (max-width: 500px) {
    .small-posts {
      grid-template-columns: 1fr;
    }
  }
</style>