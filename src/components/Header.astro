<style is:global>
  /* Remove default browser spacing */
  html,
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background-size: cover;
    max-width: 100%;
    min-height: 150%;
    background-repeat: no-repeat;
  }
</style>

<!-- Main Header w/ Nav -->
<div id="container">
  <main>
    <header>
      <div class="title">
        <a class="title-link" href="/">
          <h1 class="webtitle">Cae's Game Reviews</h1>
          <p class="tagline">A college student's thoughts on games.</p>
        </a>
      </div>
      <nav>
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/blog">All Posts</a>
      </nav>
    </header>
  </main>
</div>

<!--Header style -->
<style>
  header {
    background-color: rgb(188, 35, 35);
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem max(2rem, calc((100% - 1100px) / 2));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: sticky;
    top: 0;
    z-index: 100;
    margin-bottom: 1rem;
  }

  .title {
    text-align: left;
    flex-shrink: 0;
    font-family: 'Pixelify Sans', sans-serif;
  }

  .webtitle {
    margin: 0;
    padding: 0;
  }

  .tagline {
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .title-link {
    padding: 0;
    color: black;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  nav a {
    padding: 0.75rem;
    color: black;
    text-decoration: none;
    font-weight: bold;
    white-space: nowrap;
    font-family: 'Pixelify Sans', sans-serif;
  }

  nav a:hover {
    color: white;
  }

  .title-link:hover {
    color: black;
  }

  @media (max-width: 700px) {
    header {
      padding: 0.75rem 1rem;
      flex-wrap: wrap;
    }

    .webtitle {
      font-size: 1.4rem;
    }

    nav {
      gap: 0;
    }

    nav a {
      padding: 0.5rem;
    }
  }
</style>
